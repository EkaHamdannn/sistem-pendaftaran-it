#--------------------------------------------------------------------
# CodeIgniter 4 — Environment Configuration
#--------------------------------------------------------------------
# Salin file ini menjadi .env (tanpa .example) di root proyek CI4.
# Sesuaikan nilai database dengan konfigurasi MySQL Anda.
#--------------------------------------------------------------------

CI_ENVIRONMENT = development

#--------------------------------------------------------------------
# APP
#--------------------------------------------------------------------

app.baseURL = 'http://localhost:8080/'

# Aktifkan CSRF protection
# (sudah dikonfigurasi via Config/Filters.php)

#--------------------------------------------------------------------
# DATABASE
#--------------------------------------------------------------------

database.default.hostname = localhost
database.default.database = db_pelatihan_it
database.default.username = root
database.default.password =
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.port     = 3306
database.default.charset  = utf8mb4
database.default.DBCollat = utf8mb4_unicode_ci

#--------------------------------------------------------------------
# ENCRYPTION (untuk session)
#--------------------------------------------------------------------
# Ganti dengan key acak 32 karakter hex. Contoh generate:
# php -r "echo bin2hex(random_bytes(16));"
# encryption.key = hex2bin:<your_hex_key>

#--------------------------------------------------------------------
# SESSION
#--------------------------------------------------------------------

# session.driver      = 'CodeIgniter\Session\Handlers\FileHandler'
# session.savePath    = WRITEPATH . 'session'
